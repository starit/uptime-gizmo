# pnpm is the supported package manager for this repository.
# Do not commit package-lock.json or yarn.lock; see CONTRIBUTING.md.

# Faithful mapping of the previous npm `legacy-peer-deps=true`: peer
# dependencies are neither auto-installed nor treated as install failures.
auto-install-peers=false
strict-peer-dependencies=false

# Do not install a version published less than 14 days ago. pnpm counts this in
# minutes, unlike npm's `min-release-age`, which counted days.
minimum-release-age=20160

# Exemptions, each one a package pinned exactly by a dependent so pnpm cannot
# fall back to an older release, or one that publishes faster than the window:
#   @aws-sdk/*  daily releases, reaches us only as an optional peer of mongodb
#   @vue/*, vue  Vue pins its own runtime packages to the exact same version
#   postcss      pinned exactly by the postcss-* tooling we depend on
# Each entry removes supply-chain protection for that package. Adding one is a
# decision to raise in review, not a routine fix for a failing install.
minimum-release-age-exclude[]=@aws-sdk/*
minimum-release-age-exclude[]=@vue/*
minimum-release-age-exclude[]=vue
minimum-release-age-exclude[]=postcss
