# Copy to .env and change what you need. Every variable here is optional: an
# instance with none of them set runs on its defaults.
#
# Listed here are the settings an operator chooses. Debug and test switches
# (SQL_LOG, TEST_BACKEND, UPTIME_GIZMO_DEBUG_INSPECTOR and the like) are
# deliberately absent — they belong to a development session, not to a
# deployment.

# ─── Serving ────────────────────────────────────────────────────────────────

# Where the backend listens. PORT is honoured too, for platforms that set it.
# UPTIME_GIZMO_HOST=0.0.0.0
# UPTIME_GIZMO_PORT=3001

# Where the SQLite database and uploads live.
# DATA_DIR=./data

# Serve over TLS directly, rather than behind a proxy that terminates it.
# UPTIME_GIZMO_SSL_KEY=/path/to/key.pem
# UPTIME_GIZMO_SSL_CERT=/path/to/cert.pem
# UPTIME_GIZMO_SSL_KEY_PASSPHRASE=

# ─── API rate limits ────────────────────────────────────────────────────────
#
# Two limits, because guessing a key and using one are different problems.
# Guessing is bounded per source address at 20 a minute and is not configurable;
# a token is spent only when a key is rejected, so a client holding a valid key
# never draws that bucket down however hard it polls.
#
# Throughput is bounded per key and is what these two settings size. An instance
# driven by a fleet controller — one that polls health, reconciles state and
# forwards writes for every tenant it serves — needs more than one a person
# scripts against.
#
# Both limits live in memory, so each server process keeps its own.

# Requests a minute each API key may make. Default 60.
# UPTIME_GIZMO_API_RATE_LIMIT_PER_MINUTE=60

# Comma-separated key ids exempt from the throughput limit. A key's id is the
# number in its own prefix: uk2_… is key 2.
#
# Exempt only a key belonging to something this instance is *operated by*.
# Throttling a fleet controller throttles every tenant it serves, which is the
# reason this exists — it is not a way to make a busy script go faster.
# UPTIME_GIZMO_API_RATE_LIMIT_UNLIMITED_KEY_IDS=

# ─── Cloud integration ──────────────────────────────────────────────────────
#
# Set only when this instance is managed by an Uptime Gizmo Cloud deployment.
# All three go together: setting some but not all is refused at startup rather
# than leaving transitions silently unreported.
#
# With them set, this instance posts a signed event to Cloud whenever a monitor
# goes down or recovers. Without them nothing is sent, and Cloud sees state only
# when it next polls — which is why a Cloud deployment that alerts needs these.

# Cloud's event endpoint. HTTPS, except against a loopback host in development.
# UPTIME_GIZMO_CLOUD_EVENT_URL=https://cloud.example.com/api/internal/gizmo-events

# This instance's id in Cloud's registry, from `pnpm ops:gizmo:register`.
# UPTIME_GIZMO_CLOUD_INSTANCE_ID=

# Shared secret the event body is signed with. At least 32 characters, and the
# same value Cloud holds for this instance.
# UPTIME_GIZMO_CLOUD_EVENT_SECRET=

# ─── Monitor target policy ──────────────────────────────────────────────────
#
# Off by default, because a self-hosted instance watching its own network is the
# normal case. Turn it on where the people creating monitors are not the people
# who own the network this instance runs in — a monitor target is otherwise a
# way to make this server reach anything it can reach.

# Refuse monitor targets that resolve to private or reserved addresses.
# UPTIME_GIZMO_CLOUD_PUBLIC_TARGETS=false

# Ports a monitor target may use, comma-separated. Defaults to 80,443.
# UPTIME_GIZMO_CLOUD_ALLOWED_PORTS=80,443

# ─── Database ───────────────────────────────────────────────────────────────
#
# SQLite in DATA_DIR unless told otherwise.

# UPTIME_GIZMO_DB_TYPE=sqlite
# UPTIME_GIZMO_DB_HOSTNAME=
# UPTIME_GIZMO_DB_PORT=
# UPTIME_GIZMO_DB_NAME=
# UPTIME_GIZMO_DB_POOL_MAX_CONNECTIONS=

# ─── Misc ───────────────────────────────────────────────────────────────────

# Proxy notifications are sent through, if outbound traffic needs one.
# NOTIFICATION_PROXY=

# Reject WebSocket connections whose Origin is not this instance. Leave on
# unless a reverse proxy rewrites Origin in a way that breaks it.
# UPTIME_GIZMO_WS_ORIGIN_CHECK=true

# Timezone used for display and scheduling. Defaults to the system zone.
# TZ=
